# =============================================================================
# DataPilot AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure your production or development values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_NAME=DataPilot AI
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
FRONTEND_URL=https://datapilot-ai.vercel.app
BACKEND_URL=https://datapilot-api.onrender.com

# -----------------------------------------------------------------------------
# Allowed CORS Origins (Comma-separated for multiple domains)
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://datapilot-ai.vercel.app,https://datapilot.ai,http://localhost:3000,http://localhost:3002

# -----------------------------------------------------------------------------
# Database (PostgreSQL for Production / SQLite for Local Dev)
# -----------------------------------------------------------------------------
# Production PostgreSQL (Render / Supabase / Neon / AWS RDS):
DATABASE_URL=postgresql://datapilot:your_password@ep-sample-12345.us-east-2.aws.neon.tech/datapilot?sslmode=require
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./datapilot.db

# -----------------------------------------------------------------------------
# Redis (Caching & Celery Task Queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication & Security (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# AI Provider (Google Gemini / OpenAI / Mock)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
# For OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# File Storage (local / s3)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_PATH=/var/data/uploads
# For S3 / Cloudflare R2 / Supabase Storage:
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=datapilot-user-datasets
# STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=your_storage_access_key
# STORAGE_SECRET_KEY=your_storage_secret_key
MAX_FILE_SIZE_MB=50

# -----------------------------------------------------------------------------
# Email Notifications
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@datapilot.ai

# -----------------------------------------------------------------------------
# Payment & Subscriptions (Stripe / Mock)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Frontend Client Environment Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://datapilot-api.onrender.com
NEXT_PUBLIC_APP_NAME=DataPilot AI
