# =============================================================================
# DataPilot AI — Production Environment Configuration (Zero-Credit-Card Architecture)
# =============================================================================
# Copy this file to .env and configure your production or development values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_NAME=DataPilot AI
APP_ENV=production
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-at-least-32-chars
FRONTEND_URL=https://datapilot-ai.vercel.app
BACKEND_URL=https://datapilot-api.vercel.app

# -----------------------------------------------------------------------------
# Allowed CORS Origins (Comma-separated for multiple domains)
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://datapilot-ai.vercel.app,https://datapilot.ai,http://localhost:3000,http://localhost:3002

# -----------------------------------------------------------------------------
# Database (Free PostgreSQL via Neon / Supabase — 0 Credit Card Required)
# -----------------------------------------------------------------------------
# Neon PostgreSQL (https://neon.tech - Free, No Card):
DATABASE_URL=postgresql://your_user:your_password@ep-sample-12345.us-east-2.aws.neon.tech/datapilot?sslmode=require
# Supabase PostgreSQL (https://supabase.com - Free, No Card):
# DATABASE_URL=postgresql://postgres:your_password@db.xxxxxx.supabase.co:5432/postgres?sslmode=require
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./datapilot.db

# -----------------------------------------------------------------------------
# Authentication & Security (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=generate-a-strong-random-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# AI Provider (Google Gemini via Google AI Studio — Free API Key, No Card)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# File Storage (local / s3 / Supabase Storage S3-compatible)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
# For Free Supabase S3-compatible Object Storage (1GB Free, No Card):
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=datasets
# STORAGE_ENDPOINT=https://xxxxxx.supabase.co/storage/v1/s3
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=your_supabase_s3_access_key
# STORAGE_SECRET_KEY=your_supabase_s3_secret_key
MAX_FILE_SIZE_MB=50

# -----------------------------------------------------------------------------
# Email Notifications
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@datapilot.ai

# -----------------------------------------------------------------------------
# Payment & Subscriptions (Stripe / Mock)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# -----------------------------------------------------------------------------
# Frontend Client Environment Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://datapilot-api.vercel.app
NEXT_PUBLIC_APP_NAME=DataPilot AI
